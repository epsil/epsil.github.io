{
  "name": "website",
  "repository": {
    "type": "git",
    "url": "https://github.com/epsil/epsil.github.io.git"
  },
  "scripts": {
    "build": "npm run sitegen",
    "format": "npm run prettier",
    "prettier": "npm run prettier-js && npm run prettier-json",
    "prettier-js": "prettier --single-quote --write \"_/js/**/*.js\"",
    "prettier-json": "prettier --single-quote --write \"*.json\"",
    "sitegen": "node _/js/script/sitegen.js"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-mathjax": "^2.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-checkbox": "^1.0.6",
    "minimist": "^1.2.8",
    "minimist-options": "^4.1.0",
    "prettier": "^3.5.3",
    "tidy-html5": "^0.1.1"
  }
}
