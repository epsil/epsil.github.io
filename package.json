{
  "name": "website",
  "repository": {
    "type": "git",
    "url": "https://github.com/epsil/epsil.github.io.git"
  },
  "scripts": {
    "build": "npm run sitegen",
    "format": "npm run prettier",
    "prettier": "npm run prettier-js && npm run prettier-json",
    "prettier-js": "prettier --single-quote --write \"_/js/**/*.js\"",
    "prettier-json": "prettier --single-quote --write \"*.json\"",
    "sitegen": "node _/js/script/sitegen.js"
  },
  "dependencies": {
    "prettier": "^3.5.3"
  }
}
